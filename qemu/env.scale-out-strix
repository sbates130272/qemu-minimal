# qemu-tool settings for the scale-out ernic+rocjitsu fleet on
# snoc-strix (32 cores, 30 GiB RAM, 16 GiB /dev/shm, no discrete GPU).
#
# Same keys and same list semantics as qemu/env.scale-out -- read that file
# first; this one only records what this node needs differently, and why.
#
#   qemu-tool gen-compose --env-file qemu/env.scale-out-strix \
#     --output-dir /var/lib/qemu-tool/stacks/strix-fleet
#   docker compose --env-file qemu/env.scale-out-strix \
#     --profile metrics --profile lmcache up -d    # from that directory
#
# It is generated to a scratch directory, not over the committed stack:
# qemu/compose/vfio-user-ernic-rocjitsu-scale-out/docker-compose.yml is
# generated from qemu/env.scale-out and CI's `gen-compose --check` lane
# compares the two. A node-local run must not move that file.

# ---------------------------------------------------------------------------
# Fleet shape
# ---------------------------------------------------------------------------

# Two, and two is a real constraint here rather than a conservative choice.
# This node has 30 GiB of RAM against the fleet default's 8 GiB per guest, and
# a 16 GiB /dev/shm that every guest's memfd backend has to fit in at once.
# Three guests at the sizes below would fit neither.
#
# Two is also the smallest fleet that proves anything about the mesh, and it
# proves less than it looks: issue 18 -- every GID resolving to the same node
# -- is invisible at two nodes, because with a single peer the wrong answer
# is also the right one. Treat a 2-node pass as "the stack works", never as
# "the mesh scales"; that question needs the mi100 node.
VM_COUNT=2

# Node-local, so a run here cannot collide with the stebates-fleet-* overlays
# used elsewhere.
VM_NAME_PREFIX=strix-fleet

# One build stamp across all four (20261014.geea0485), with ernic.3fb74d1 -- the
# feat/srq-support merge. IMAGE_ALLOW_GUEST_LAG is gone: it existed only
# because the qcow2 lagged the containers and the newest coherent set
# predated SRQ, which is no longer true. Keep these four moving together.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:20261014.geea0485-qemu11.1.2-vfu.8039244
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20261014.geea0485-ernic.3fb74d1-vfu.8039244
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20261014.geea0485-rocjitsu.84fb06b
VM_BACKING_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qcow2-gen-ernic-rocjitsu:20261014.geea0485-vm.resolute-ernic-rocjitsu-qm.c5d51ce-qcow2

# The CI qcow2 bakes its own user and keypair; it is not a cloud image that
# cloud-init is about to personalise. gen-vm --backing-file skips the bake
# entirely, so these must match what the image already has or the generated
# inventory hands Ansible a user that does not exist -- which presents as
# "Permission denied (publickey,password)" with the guest perfectly healthy.
#
# Both come from the vm-info.json attached to the qcow2 as an ORAS referrer,
# alongside the keypair:
#   oras discover <qcow2 tag>            # find the vm-info digest
#   oras pull <repo>@<digest> -o <dir>   # id_rsa, id_rsa.pub, vm-info.json
VM_USERNAME=batesste
VM_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Per-guest size
# ---------------------------------------------------------------------------

# 4 is the floor, not a choice: below it ionic_create_rdma_admin() rejects the
# EQ count and ionic_rdma never probes. 2 x 4 = 8 of 32 cores, so this node is
# nowhere near the issue-14 heartbeat wall -- memory is what binds here.
VM_VCPUS=4

# 6144, not the fleet's 8192. Two 8 GiB guests plus their memfd backing would
# want 16 GiB of a 16 GiB /dev/shm with nothing left over. At 6 GiB the pair
# takes 12 GiB and leaves headroom for the stack's own containers.
#
# The guest still has room for what it is here to run: LMCache L1 is 2 GiB
# (lmcache_guest_l1_size_gb), and the registration ceiling that matters is the
# page-table one in ionic_pgtbl.c, which huge pages address -- not guest RAM.
VM_VMEM=6144
VM_SHM_SIZE=6g

ROCJITSU_CONFIG=gfx1250_mi455x.json

# One emulated NVMe per guest, which is where LMCache's L2 tier lives.
# Omitting it does not quietly disable L2: lmcache_guest's l2_nvme.yml fails
# the play with "/dev/nvme0n1 is not a block device in this guest", after
# every expensive task before it has already run. run-vm creates the backing
# qcow2 itself (<vm-name>-nvme1 under VM_IMAGES_DIR), so unlike the root disk
# there is no gen-vm step to pair with this.
VM_NVME=1

# In-tree, as on the dev box: this node's /home is local disk, not NFS, so the
# shared-backing caveat that applies on the mi100 rack does not apply here.
VM_IMAGES_DIR=${HOME}/Projects/qemu-minimal/images
VM_BACKING_SHARED=true

# ---------------------------------------------------------------------------
# Fleet-wide
# ---------------------------------------------------------------------------

FLEET_NET_PREFIX=172.31
ERNIC_TCP_PORT=6320
VM_SSH_PORT_BASE=2222
ERNIC_MAC_PREFIX=72:6f:63:6d
ERNIC_GUEST_SUBNET=192.168.100
VM_EXTRA_HOSTFWD=tcp::9100-:9100
ERNIC_STATS_PORT=9840

# The TAP is what makes inter-node anything possible: the TCP mesh carries
# RDMA payload only, so without Ethernet the guests cannot ARP and
# ib_send_bw's out-of-band exchange never happens.
ERNIC_TAP=true
ERNIC_NOFILE=65536

# ---------------------------------------------------------------------------
# LMCache -- the point of this node's runs
# ---------------------------------------------------------------------------

LMCACHE_ENABLE=true

# Exported to every guest over 9p, and the only sane way in for a 10.8 GB
# image: `docker save` once to this directory and all guests load the same
# file, rather than each being handed its own copy or pulling from a registry
# VM_COUNT times through SLIRP. The generator defaults this to empty, so it
# has to be stated or lmcache_guest falls back to a registry pull.
VM_FILESYSTEM=/var/lib/qemu-tool/share

# Stated rather than inherited from the generator default, because the tag is
# load-bearing: -srq is the only build whose nixl is the rocm wheel variant,
# and a fleet that mixes variants cannot unpickle its peers' descriptors. See
# LMCACHE_IMAGE in qemu/env.scale-out for the full chain.
LMCACHE_IMAGE=qemu-tool/lmcache-rocm:0.5.6-gfx1250-srq

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Create this and `chown 65534:65534` it before the first `up`: Prometheus
# runs as nobody and will not create its own TSDB directory.
PROM_DATA_DIR=/var/lib/qemu-tool/stacks/strix-fleet/prom-data
PROM_PORT=9090
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=7d

QEMU_TOOL_SRC=${HOME}/Projects/qemu-minimal
