<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI overlay for the helios-tray stack.  Keys here override helios-tray.xml
  when gen-compose and compose are driven with --fleet-file overlay-helios-ci.xml
  as the second file.  Only CI-specific differences are listed.
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">

  <!-- CI runner has 4 cores; size to match (4 vCPU floor for ionic_rdma). -->
  <vm-vcpus>4</vm-vcpus>
  <!-- 6144 MB leaves ~2 GB headroom on a typical ubuntu-latest runner. -->
  <vm-vmem>6144</vm-vmem>
  <vm-shm-size>8g</vm-shm-size>

  <!-- CI-local image paths. -->
  <vm-images-dir>/var/lib/qemu-tool/images</vm-images-dir>
  <vm-name-prefix>helios-ci</vm-name-prefix>

  <!-- Stack dir is /var/lib/qemu-tool/stacks/helios-ci; prom-data under it. -->
  <prom-data-dir>/var/lib/qemu-tool/stacks/helios-ci/prom-data</prom-data-dir>

</fleet>
