# qemu-tool settings for the scale-out ernic+rocjitsu fleet on
# ctr-mi100-rack33a-9 (192 cores, 976 GiB, 489 GiB /dev/shm, 8x MI100).
#
# Same keys and same list semantics as qemu/env.scale-out -- read that file
# first; this one only records what this node needs differently, and why.
#
#   qemu-tool gen-compose --env-file qemu/env.scale-out-mi100 \
#     --output-dir /var/lib/qemu-tool/stacks/mi100-fleet
#   docker compose --env-file qemu/env.scale-out-mi100 \
#     --profile metrics up -d       # from that directory
#
# It is generated to a scratch directory, not over the committed stack:
# qemu/compose/vfio-user-ernic-rocjitsu-scale-out/docker-compose.yml is
# generated from qemu/env.scale-out and CI's `gen-compose --check` lane
# compares the two. A node-local run must not move that file.

# ---------------------------------------------------------------------------
# Fleet shape
# ---------------------------------------------------------------------------

# Set per ramp step. 192 cores at 4 vCPU/VM budgets ~48 VMs by the issue-14
# heartbeat rule; the ~40-node mesh registration wall (issue 17) was measured
# on a 128-core host and is what this ramp is here to re-measure.
VM_COUNT=4

# NOT stebates-fleet. /home is NFS and shared across nodes, and the
# stebates-fleet-* overlays were being written by a live fleet on another
# node while this one was being set up. A node-local prefix and a node-local
# VM_IMAGES_DIR are what keep the two runs from corrupting each other.
VM_NAME_PREFIX=stebates-mi100

# ---------------------------------------------------------------------------
# Images -- one build stamp across all four
# ---------------------------------------------------------------------------
#
# 20261005.g816a687 containers, and the newest qcow2 there is -- which is a
# stamp older, 20260929's vm.resolute-...-qm.54cc234.
#
# The obvious choice is the newest stamp at which all four exist, 20260929,
# and it is wrong. rocm-ernic 1484557 -- the ernic in that stamp -- still has
# the GID-resolution bug of AGENTS.md issue 18: every destination resolves to
# the first other node the instance knows, so a worker can only reach the
# manager. Measured here before the switch, on 8 nodes: every pair whose
# destination was vm1 passed, every other pair failed with "Completion with
# error at client / status 10 syndrom 0x9" and the manager logged "SEND from
# node 1 to unknown QP 8". The fixes (a01bc30, cdfee43 #209, 6c84c23) land
# AFTER 1484557 and merge at 76af59f, which is the ernic in 20261005.
#
# Pairing a 20260929 guest image with 20261005 servers is safe here in a way
# it would not normally be, because what crosses the vfio-user/DSR boundary is
# the guest's ionic driver, and this fleet builds that itself: `git diff
# 1484557 76af59f -- patches/ udev/ cmake/ErnicKernelModule.cmake` is empty,
# so the driver is byte-identical either way and only the server moved.
#
# The qcow2 is named by its unstamped tag on purpose. gen-compose's coherence
# check excludes unstamped refs with a warning (gen_compose.py:162-179), which
# is the honest way to say "these three move together, that one is pinned
# separately" rather than defeating the check. Put all four back on one stamp
# as soon as a qcow2 publishes at 20261005 or later.
# QEMU is a LOCAL build, not a published image, and it is what makes
# VRAM-backed RDMA work. The stock ubuntu-qemu-libvfio-user builds upstream
# QEMU from gitlab (Dockerfile: QEMU_REPO=.../qemu-project/qemu.git), so it
# does not carry sbates130272/qemu 31e3d06a4 "hw/vfio: assign region fd to
# RAMBlock for vfio-user P2P DMA". Without that commit a peer device's BAR is
# DMA_MAP-ed to the NIC with no fd, arrives as vaddr=(nil), and every WQE
# touching GPU memory dies in vfu_sgl_get() as "could not gather N bytes".
#
# batesste-ci-images already has an `sbates-fork` variant that builds from the
# fork and publishes as ...-ubuntu-qemu-libvfio-user-sbates-fork -- but it is
# pinned to qemu_commit d757fa6cb (2026-09-22), which is the commit *before*
# 31e3d06a4 (2026-09-26). Bump that pin and this can go back to a published
# tag. Rebuild locally meanwhile:
#
#   git clone https://github.com/sbates130272/batesste-ci-images.git
#   cd batesste-ci-images && docker build \
#     -f ubuntu-qemu-libvfio-user/Dockerfile -t local/qemu-p2p:31e3d06a4-vfu.8039244 \
#     --build-arg BASE_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-libvfio-user:20261005.g816a687-vfu.8039244 \
#     --build-arg QEMU_REPO=https://github.com/sbates130272/qemu.git \
#     --build-arg QEMU_COMMIT=31e3d06a4e3e1d610f00dc8045d2c3a0ea97fb00 \
#     --build-arg QEMU_MINIMAL_REPO=https://github.com/sbates130272/qemu-minimal.git \
#     --build-arg QEMU_MINIMAL_COMMIT=54cc234d0668a6c3d34140fcc24cff20c32e5724 .
#
# Verify with `-device help | grep pci-mmio-bridge` (present only in fork
# builds) and /build/qemu-commit.txt.
QEMU_IMAGE=local/qemu-p2p:31e3d06a4-vfu.8039244
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20261005.g816a687-ernic.76af59f-vfu.8039244
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20261005.g816a687-rocjitsu.8677978
VM_BACKING_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qcow2-gen-ernic-rocjitsu:vm.resolute-ernic-rocjitsu-qm.54cc234-qcow2

# ---------------------------------------------------------------------------
# Guest login
# ---------------------------------------------------------------------------
#
# Recorded here for the reader; gen-vm does NOT apply them on this path.
# --backing-image skips cloud-init entirely (gen_vm.py:78-81), and the
# published qcow2 bakes exactly one user, `batesste`, holding an authorized
# key for root@buildkitsandbox that nobody outside CI has. The `ubuntu` user,
# its password, its NOPASSWD sudo and the fleet SSH key were added to the
# backing image offline with virt-customize -- see the runbook in
# artifacts/scaling-report-mi100.md.
VM_USERNAME=ubuntu
VM_PASSWORD=ubuntu

# ---------------------------------------------------------------------------
# Per-VM resources
# ---------------------------------------------------------------------------

# 4 is the floor on an ernic stack: ionic_create_rdma_admin() rejects fewer
# than IONIC_EQ_COUNT_MIN EQs and ionic_rdma never probes.
VM_VCPUS=4
VM_VMEM=8192
VM_SHM_SIZE=8g

# 489 GiB of /dev/shm here, so the shm ceiling is ~61 VMs at 8g -- it no
# longer binds before the mesh wall does, unlike the 252 GiB host.

ROCJITSU_CONFIG=gfx1250_mi455x.json

# ---------------------------------------------------------------------------
# Fleet-wide
# ---------------------------------------------------------------------------

# Local NVMe (/dev/sda3, 3.4T free), not the in-tree images/ directory: that
# path is NFS here, qcow2 locking over NFS is unreliable, and 64 guests doing
# overlay writes over NFS is a boot-time cost the measurement does not need.
VM_IMAGES_DIR=/var/lib/qemu-tool/images-stebates

VM_BACKING_SHARED=true

# 172.26/16 is in use on this node by another user's 4-VM stack
# (johtyler-erv4_default); 172.31 is free.
FLEET_NET_PREFIX=172.31

ERNIC_TCP_PORT=6320

# ---------------------------------------------------------------------------
# Derived per-VM identity
# ---------------------------------------------------------------------------

# The other stack on this node publishes 2240-2243, so 2222+ is clear to 2285.
VM_SSH_PORT_BASE=2222
ERNIC_MAC_PREFIX=72:6f:63:6d
ERNIC_GUEST_SUBNET=192.168.100

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

VM_EXTRA_HOSTFWD=tcp::9100-:9100
ERNIC_STATS_PORT=9840

# Without this the TCP mesh carries RDMA payload only, ARP goes unanswered,
# and neither ib_send_bw's out-of-band exchange nor any iperf3 run works.
ERNIC_TAP=true

ERNIC_NOFILE=65536

# Absolute, and per run: the TSDB is the record of one fleet size, and the
# ramp overwrites it otherwise. Create it and chown 65534:65534 before `up`.
PROM_DATA_DIR=/var/lib/qemu-tool/stacks/mi100-fleet/prom-data

PROM_PORT=9090
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=7d

# ---------------------------------------------------------------------------
# Compose-only
# ---------------------------------------------------------------------------

# Absolute: the stack is generated outside the repo, so the default
# ../../.. does not reach the checkout.
QEMU_TOOL_SRC=/home/AMD/stebates/Projects/qemu-minimal
