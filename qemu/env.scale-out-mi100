# qemu-tool settings for the scale-out ernic+rocjitsu fleet on
# ctr-mi100-rack33a-9 (192 cores, 976 GiB, 489 GiB /dev/shm, 8x MI100).
#
# Same keys and same list semantics as qemu/env.scale-out -- read that file
# first; this one only records what this node needs differently, and why.
#
#   qemu-tool gen-compose --env-file qemu/env.scale-out-mi100 \
#     --output-dir /var/lib/qemu-tool/stacks/mi100-fleet
#   docker compose --env-file qemu/env.scale-out-mi100 \
#     --profile metrics up -d       # from that directory
#
# It is generated to a scratch directory, not over the committed stack:
# qemu/compose/vfio-user-ernic-rocjitsu-scale-out/docker-compose.yml is
# generated from qemu/env.scale-out and CI's `gen-compose --check` lane
# compares the two. A node-local run must not move that file.

# ---------------------------------------------------------------------------
# Fleet shape
# ---------------------------------------------------------------------------

# Set per ramp step. 192 cores at 4 vCPU/VM budgets ~48 VMs by the issue-14
# heartbeat rule; the ~40-node mesh registration wall (issue 17) was measured
# on a 128-core host and is what this ramp is here to re-measure.
VM_COUNT=32

# NOT stebates-fleet. /home is NFS and shared across nodes, and the
# stebates-fleet-* overlays were being written by a live fleet on another
# node while this one was being set up. A node-local prefix and a node-local
# VM_IMAGES_DIR are what keep the two runs from corrupting each other.
VM_NAME_PREFIX=stebates-mi100

# ---------------------------------------------------------------------------
# Images -- one build stamp across all four
# ---------------------------------------------------------------------------
#
# One coherent build stamp across all four, 20261007.g677e113 -- which is
# what the stack is designed around and what gen-compose's coherence check
# wants. Two things that needed working around are closed by it:
#
#   The QEMU is the sbates-fork variant, so it carries 31e3d06a4 "hw/vfio:
#   assign region fd to RAMBlock for vfio-user P2P DMA". Without that commit
#   a peer device's BAR is DMA_MAP-ed to the NIC with no fd, arrives as
#   vaddr=(nil), and every WQE touching GPU memory dies in vfu_sgl_get() as
#   "could not gather N bytes". This file used to point at a local build for
#   exactly that reason; it no longer has to.
#
#   The ernic is f7e3ecb, well past 76af59f, so the GID-resolution fixes of
#   AGENTS.md issue 18 are in -- a worker can reach more than just the mesh
#   manager.
#
# Verify a candidate QEMU image with `-device help | grep pci-mmio-bridge`,
# which is present only in fork builds, and /build/qemu-commit.txt.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user-sbates-fork:20261007.g677e113-qemu.31e3d06-vfu.8039244
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20261007.g677e113-ernic.f7e3ecb-vfu.8039244
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20261007.g677e113-rocjitsu.4c86d86
VM_BACKING_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qcow2-gen-ernic-rocjitsu:20261007.g677e113-vm.resolute-ernic-rocjitsu-qm.a76e881-qcow2

# ---------------------------------------------------------------------------
# Guest login
# ---------------------------------------------------------------------------
#
# Recorded here for the reader; gen-vm does NOT apply them on this path.
# --backing-image skips cloud-init entirely (gen_vm.py:78-81), and the
# published qcow2 bakes exactly one user, `batesste`, holding an authorized
# key for root@buildkitsandbox that nobody outside CI has. The `ubuntu` user,
# its password, its NOPASSWD sudo and the fleet SSH key were added to the
# backing image offline with virt-customize -- see the runbook in
# artifacts/scaling-report-mi100.md.
VM_USERNAME=ubuntu
VM_PASSWORD=ubuntu

# ---------------------------------------------------------------------------
# Per-VM resources
# ---------------------------------------------------------------------------

# 4 is the floor on an ernic stack: ionic_create_rdma_admin() rejects fewer
# than IONIC_EQ_COUNT_MIN EQs and ionic_rdma never probes.
VM_VCPUS=4
VM_VMEM=8192
VM_SHM_SIZE=8g

# 489 GiB of /dev/shm here, so the shm ceiling is ~61 VMs at 8g -- it no
# longer binds before the mesh wall does, unlike the 252 GiB host.

ROCJITSU_CONFIG=gfx1250_mi455x.json

# ---------------------------------------------------------------------------
# Fleet-wide
# ---------------------------------------------------------------------------

# Local NVMe (/dev/sda3, 3.4T free), not the in-tree images/ directory: that
# path is NFS here, qcow2 locking over NFS is unreliable, and 64 guests doing
# overlay writes over NFS is a boot-time cost the measurement does not need.
VM_IMAGES_DIR=/var/lib/qemu-tool/images-stebates

VM_BACKING_SHARED=true

# 172.26/16 is in use on this node by another user's 4-VM stack
# (johtyler-erv4_default); 172.31 is free.
FLEET_NET_PREFIX=172.31

ERNIC_TCP_PORT=6320

# ---------------------------------------------------------------------------
# Derived per-VM identity
# ---------------------------------------------------------------------------

# The other stack on this node publishes 2240-2243, so 2222+ is clear to 2285.
VM_SSH_PORT_BASE=2222
ERNIC_MAC_PREFIX=72:6f:63:6d
ERNIC_GUEST_SUBNET=192.168.100

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

# A real MI100 passed through, alongside the emulated ernic. This is a
# list[str] field, so the value goes to EVERY VM -- which is why this file
# runs VM_COUNT=1 while it is set. One PCI function cannot be assigned to
# two guests, so a fleet with passthrough would need per-VM hostdev support
# the generator does not have.
#
# Bind it first, by BDF rather than by vendor:device, or all eight get taken:
#   echo vfio-pci > /sys/bus/pci/devices/0000:03:00.0/driver_override
#   echo 0000:03:00.0 > /sys/bus/pci/drivers/amdgpu/unbind
#   echo 0000:03:00.0 > /sys/bus/pci/drivers_probe
#VM_PCI_HOSTDEV=0000:03:00.0

VM_EXTRA_HOSTFWD=tcp::9100-:9100
ERNIC_STATS_PORT=9840

# Without this the TCP mesh carries RDMA payload only, ARP goes unanswered,
# and neither ib_send_bw's out-of-band exchange nor any iperf3 run works.
ERNIC_TAP=true

ERNIC_NOFILE=65536

# Absolute, and per run: the TSDB is the record of one fleet size, and the
# ramp overwrites it otherwise. Create it and chown 65534:65534 before `up`.
PROM_DATA_DIR=/var/lib/qemu-tool/stacks/mi100-fleet/prom-data

PROM_PORT=9090
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=7d

# ---------------------------------------------------------------------------
# Compose-only
# ---------------------------------------------------------------------------

# Absolute: the stack is generated outside the repo, so the default
# ../../.. does not reach the checkout.
QEMU_TOOL_SRC=/home/AMD/stebates/Projects/qemu-minimal
