# qemu-tool settings for the two-VM LMCache fleet that
# .github/workflows/qemu-minimal-report-for-lmcache.yml runs.
#
# Same keys and same list semantics as qemu/env.scale-out -- read that file
# first; this one only records what CI needs differently, and why.
#
# Generated to a scratch directory by the lane, never over the committed
# stack: qemu/compose/vfio-user-ernic-rocjitsu-scale-out/docker-compose.yml is
# generated from qemu/env.scale-out and `gen-compose --check` compares the two.
#
# VM_VCPUS and VM_VMEM are NOT set here. The lane derives them from the runner
# it lands on, the same way report-for-vm-ernic.yml does, and exports them to
# the environment -- a GitHub runner is smaller than any node a human runs
# this on, and taking the fleet defaults would ask for more than it has.

# Two: the smallest fleet that can move a byte between guests, and as many as
# a GitHub runner can boot. It proves transport, not scale -- issue 18 is
# invisible at two nodes, because with a single peer the wrong answer is also
# the right one.
VM_COUNT=2

VM_NAME_PREFIX=lmcache-ci

# One build stamp across all four (20261014.geea0485), with ernic.3fb74d1 -- the
# feat/srq-support merge. IMAGE_ALLOW_GUEST_LAG is gone: it existed only
# because the qcow2 lagged the containers and the newest coherent set
# predated SRQ, which is no longer true. Keep these four moving together.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:20261014.geea0485-qemu11.1.2-vfu.8039244
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20261014.geea0485-ernic.3fb74d1-vfu.8039244
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20261014.geea0485-rocjitsu.84fb06b
VM_BACKING_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qcow2-gen-ernic-rocjitsu:20261014.geea0485-vm.resolute-ernic-rocjitsu-qm.c5d51ce-qcow2

VM_USERNAME=batesste
VM_PASSWORD=changeme

# Runner-local. Bind-mounted into the job container at the same path so the
# qcow2 generated in the container is the file the sibling qemu containers
# open -- compose bind-mounts resolve on the host daemon, not in here.
VM_IMAGES_DIR=/var/lib/qemu-tool/images
VM_BACKING_SHARED=true

# L2 lives on an emulated NVMe. Omitting it does not disable L2: the role
# fails with "/dev/nvme0n1 is not a block device in this guest" after every
# expensive task before it has already run.
VM_NVME=1

ROCJITSU_CONFIG=gfx1250_mi455x.json

FLEET_NET_PREFIX=172.31
ERNIC_TCP_PORT=6320
VM_SSH_PORT_BASE=2222
ERNIC_MAC_PREFIX=72:6f:63:6d
ERNIC_GUEST_SUBNET=192.168.100
ERNIC_STATS_PORT=9840

# The TAP is what makes inter-node anything possible: the TCP mesh carries
# RDMA payload only, so without Ethernet the guests cannot ARP.
ERNIC_TAP=true
ERNIC_NOFILE=65536

LMCACHE_ENABLE=true

# Built by the lane from qemu/docker/lmcache/Dockerfile, not pulled: nothing
# publishes this image. One tag across the fleet is load-bearing -- NIXL
# pickles descriptor lists and a guest on a different nixl variant cannot
# unpickle its peer's. See LMCACHE_IMAGE in qemu/env.scale-out.
LMCACHE_IMAGE=qemu-tool/lmcache-rocm:0.5.6-gfx1250-srq

# Exported to the guests over 9p: `docker save` once and every guest loads the
# same file, rather than each pulling ~10.8 GB through SLIRP.
VM_FILESYSTEM=/var/lib/qemu-tool/share
