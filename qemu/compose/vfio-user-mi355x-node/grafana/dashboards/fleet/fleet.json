{
  "uid": "ernic-fleet",
  "title": "ernic + rocjitsu fleet",
  "description": "Fleet health, ernic RDMA counters and per-VM status. Not generated: every query aggregates or groups by label, so nothing in here mentions a VM by name and VM_COUNT can change under it without an edit. Series colours are the four validated categorical slots for a dark surface; per-VM panels are bar gauges rather than N lines, because a line per VM stops being readable at the fleet sizes this stack supports.",
  "tags": [
    "ernic",
    "rocjitsu",
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fleet-prometheus"
        },
        "query": "label_values(up{job=\"fleet-node\"}, vm_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Guests up",
      "description": "node-exporter responding, which means the guest booted and QEMU's hostfwd reached it. A guest that died with its ernic (AGENTS.md issue 7) drops out here first.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"fleet-node\"} == 1) or vector(0)",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "count(up{job=\"fleet-node\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e66767",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRefId",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "up"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRefId",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "expected"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "ernic instances",
      "description": "rocm-ernic processes writing stats dumps. Should equal VM_COUNT. A number that climbs above it means workers are restarting -- every reconnect takes a fresh mesh node id and never reclaims the old one, against a 64-node ceiling (AGENTS.md issue 13).",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 19,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ernic_instances",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "ernic RDMA",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "RDMA throughput, fleet total",
      "description": "Four operations on one byte/sec axis. Summed across the fleet deliberately: a line per VM stops being readable well before this stack's ~40-node ceiling, and per-VM detail is the bar gauge below.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ernic_rdma_bytes_sent_total[$__rate_interval]))",
          "legendFormat": "send"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ernic_rdma_bytes_received_total[$__rate_interval]))",
          "legendFormat": "recv"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ernic_rdma_bytes_read_total[$__rate_interval]))",
          "legendFormat": "rdma read"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ernic_rdma_bytes_write_total[$__rate_interval]))",
          "legendFormat": "rdma write"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "send"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recv"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rdma read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rdma write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Guest Ethernet through the TAP, fleet total",
      "description": "Only moves when ERNIC_TAP is on. The TCP mesh carries RDMA payload only, so with no TAP attached the guest driver transmits, the device drops, and this stays flat at zero while ethtool -S still counts the packets.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ernic_ip_bytes_tx_total[$__rate_interval]))",
          "legendFormat": "tx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ernic_ip_bytes_rx_total[$__rate_interval]))",
          "legendFormat": "rx"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "RDMA bytes/sec by node",
      "description": "Per-ernic, so an idle node in a fleet that should be symmetric is visible at a glance. One hue: this is magnitude, not identity.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ernic_id, role) (rate(ernic_rdma_bytes_total[$__rate_interval]))",
          "legendFormat": "{{ernic_id}} ({{role}})",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Doorbells and completions, fleet total",
      "description": "Doorbell rings are MMIO into the emulated device and completions come back out of it, so this is the closest thing the stack has to a measure of how hard rocm-ernic's single thread is being worked.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ernic_qp_doorbell_send_total[$__rate_interval]))",
          "legendFormat": "send doorbells"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ernic_qp_doorbell_recv_total[$__rate_interval]))",
          "legendFormat": "recv doorbells"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ernic_qp_cqes_posted_total[$__rate_interval]))",
          "legendFormat": "CQEs posted"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ernic_qp_wqes_processed_total[$__rate_interval]))",
          "legendFormat": "WQEs processed"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "send doorbells"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recv doorbells"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CQEs posted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WQEs processed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Guests",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "CPU busy by VM",
      "description": "Each guest has VM_VCPUS cores and the fleet is sized so VM_VCPUS x VM_COUNT is at or under the host's. Sustained high values here are the shape that precedes the mesh manager's untunable 20s heartbeat timeout firing on live nodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (vm_name) (rate(node_cpu_seconds_total{job=\"fleet-node\",mode=\"idle\",vm_name=~\"$vm\"}[$__rate_interval])) * 100)",
          "legendFormat": "{{vm_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#199e70",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 75
              },
              {
                "color": "#e66767",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Memory used by VM",
      "description": "Memory is not what the fleet runs out of -- 48 VMs used 107G of 503G on the measured host -- so this is here to confirm that, not to watch it.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"fleet-node\",vm_name=~\"$vm\"} / node_memory_MemTotal_bytes{job=\"fleet-node\",vm_name=~\"$vm\"}))",
          "legendFormat": "{{vm_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#199e70",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 80
              },
              {
                "color": "#e66767",
                "value": 92
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Per-VM status",
      "description": "The identity view: which guest, and is its scrape target answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"fleet-node\",vm_name=~\"$vm\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "vm_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "__name__": true,
              "__name__ 1": true,
              "job": true,
              "job 1": true,
              "instance": true,
              "instance 1": true,
              "vm": true,
              "vm 1": true
            },
            "renameByName": {
              "vm_name": "VM",
              "Value #A": "guest"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "guest"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "index": 0,
                        "color": "#e66767"
                      },
                      "1": {
                        "text": "UP",
                        "index": 1,
                        "color": "#199e70"
                      }
                    }
                  }
                ]
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      }
    }
  ]
}
