# Docker image references.
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:latest
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:latest

# Path to the qemu-minimal repo root (used to install qemu-tool into the qemu container).
QEMU_TOOL_SRC=../../..

# Directory containing qcow2 VM images.
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# VM name — basename of the qcow2 without extension.
VM_NAME=qemu-minimal

# VM resources.
VM_VCPUS=4
VM_VMEM=8192

# SSH port forwarded from the qemu container to the host.
VM_SSH_PORT=2222

# Shared memory for the vfio-user memfd backend (must be >= VM_VMEM MiB).
VM_SHM_SIZE=8g
