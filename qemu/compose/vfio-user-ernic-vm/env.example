# Docker image references.
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20260919.g959f0cf-ernic.0b48aa1-vfu.8039244
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:20260918.g7438e48-qemu11.1.1-vfu.8039244

# Path to the qemu-minimal repo root (used to install qemu-tool into the qemu container).
QEMU_TOOL_SRC=../../..

# Directory containing qcow2 VM images.
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# VM name — basename of the qcow2 without extension.
VM_NAME=qemu-minimal

# VM resources.
# Do not drop VM_VCPUS below 4: ionic_create_rdma_admin() hard-fails under
# IONIC_EQ_COUNT_MIN, because ionic_lif_size() sets neqs from
# num_online_cpus(). Below four, ionic_rdma never probes and the only symptom
# is "Failed to register ibdev" in the guest log.
VM_VCPUS=4
VM_VMEM=8192

# SSH port forwarded from the qemu container to the host.
VM_SSH_PORT=2222

# Shared memory for the vfio-user memfd backend (must be >= VM_VMEM MiB).
VM_SHM_SIZE=8g
