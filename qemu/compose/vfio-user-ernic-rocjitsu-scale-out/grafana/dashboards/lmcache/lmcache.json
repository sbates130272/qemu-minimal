{
  "uid": "lmcache-fleet",
  "title": "LMCache \u2014 stores, retrieves and P2P",
  "description": "Per-node L1/L2 store and retrieve activity across the fleet, built only on series observed on a running server. The coordinator's directory is deliberately absent: it is HTTP-only, see the last row.",
  "tags": [
    "lmcache",
    "fleet",
    "p2p"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "fleet-prometheus"
        },
        "query": "label_values(up{job=\"lmcache-server\"}, vm_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Substring filter applied to every log panel below."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "LMCache servers up",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Scrape reachability of each guest's MP server. A server can be up and still not registered with the coordinator -- confirm with: curl -s localhost:9300/instances",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count(up{job=\"lmcache-server\"} == 1) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e66767",
                "value": null
              },
              {
                "color": "#199e70",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "L1 hit share of lookups",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Tokens served from L1 as a fraction of tokens requested, fleet-wide. The rest came from L2 -- which on this fleet means either the local NVMe or a peer's memory over P2P.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(lmcache_mp_lookup_hit_l1_tokens_total) / clamp_min(sum(lmcache_mp_lookup_requested_tokens_total), 1)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Active P2P lookups",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Peer lookups in flight. This is the P2P path working: a lookup here is one guest asking a peer to locate a prefix it is about to read out of that peer's L1. Flat zero on an idle fleet is correct.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(lmcache_mp_active_p2p_lookup_jobs) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#199e70"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Coordinator",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "The MP coordinator. Membership and the key directory; never in the KV path.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max(up{job=\"lmcache-coordinator\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "index": 0,
                  "color": "#e66767"
                },
                "1": {
                  "text": "UP",
                  "index": 1,
                  "color": "#199e70"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e66767",
                "value": null
              },
              {
                "color": "#199e70",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Stores",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Store rate, fleet total",
      "description": "Submitted vs finished stores. A persistent gap means stores are queueing faster than the backends drain them.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lmcache_mp_num_submitted_stores_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "submitted"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lmcache_mp_num_finished_stores_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "finished"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "submitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "finished"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Stores finished by node",
      "description": "Per guest. A bar gauge rather than a line per VM: one line per VM stops being readable well before this stack's ~40-node ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm_name) (lmcache_mp_num_finished_stores_total{vm_name=~\"$vm\"})",
          "legendFormat": "{{vm_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "L1 chunks written by node",
      "description": "Chunks written into each guest's L1. This is the tier P2P peers read out of, so it is the fleet's shared cache rather than local bookkeeping.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm_name) (lmcache_mp_l1_write_chunks_total{vm_name=~\"$vm\"})",
          "legendFormat": "{{vm_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "L2 stores completed by node and adapter",
      "description": "Split by l2_name: 'fs' is the emulated NVMe, 'p2p' is a peer's memory. A guest that only ever stores locally shows 'fs' alone.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm_name, l2_name) (lmcache_mp_l2_store_completed_requests_total{vm_name=~\"$vm\"})",
          "legendFormat": "{{vm_name}} {{l2_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Retrieves",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lookup hits by tier, fleet total",
      "description": "Where lookups are served from. L1 is local memory; L2 is the NVMe or a peer. Both are token counts, which is the only reason they share an axis.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lmcache_mp_lookup_hit_l1_tokens_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "L1 hit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lmcache_mp_lookup_hit_l2_tokens_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "L2 hit"
        },
        {
          "refId": "C",
          "expr": "sum(rate(lmcache_mp_lookup_requested_tokens_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "requested"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "L1 hit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "L2 hit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requested"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Retrieve rate, fleet total",
      "description": "Submitted vs finished retrieves.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lmcache_mp_num_submitted_retrieves_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "submitted"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lmcache_mp_num_finished_retrieves_total{vm_name=~\"$vm\"}[$__rate_interval]))",
          "legendFormat": "finished"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "submitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "finished"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "L1 reads by node",
      "description": "Chunks read out of each guest's own L1.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm_name) (lmcache_mp_l1_read_chunks_total{vm_name=~\"$vm\"})",
          "legendFormat": "{{vm_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "L2 loads completed by node and adapter",
      "description": "The P2P evidence panel. 'fs' is a read off that guest's own NVMe; 'p2p' is a read out of a PEER's L1 -- it appears only on a guest that looked up a prefix it never stored.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vm_name, l2_name) (lmcache_mp_l2_load_completed_requests_total{vm_name=~\"$vm\"})",
          "legendFormat": "{{vm_name}} {{l2_name}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "P2P \u2014 reads out of a peer's L1",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "P2P load rate, fleet total",
      "description": "Completed reads served out of a PEER's L1, fleet-wide. Compare with the 'fs' series: that is the same guest reading its own NVMe.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lmcache_mp_l2_load_completed_requests_total{vm_name=~\"$vm\",l2_name=\"p2p\"}[$__rate_interval]))",
          "legendFormat": "p2p"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lmcache_mp_l2_load_completed_requests_total{vm_name=~\"$vm\",l2_name=\"fs\"}[$__rate_interval]))",
          "legendFormat": "fs"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p2p"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "P2P transfer rate",
      "description": "Mean GB/s per completed P2P load, from the throughput histogram's sum/count. The only byte-rate figure LMCache publishes for the P2P path -- there is no cumulative byte counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lmcache_mp_l2_load_throughput_GB_per_second_sum{vm_name=~\"$vm\",l2_name=\"p2p\"}[$__rate_interval])) / clamp_min(sum(rate(lmcache_mp_l2_load_throughput_GB_per_second_count{vm_name=~\"$vm\",l2_name=\"p2p\"}[$__rate_interval])), 1)",
          "legendFormat": "p2p GB/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
