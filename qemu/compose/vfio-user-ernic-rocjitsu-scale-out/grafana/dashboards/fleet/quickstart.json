    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "id": 10,
      "title": "Guests — CPU & Memory",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "percent",
          "min": 0,
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        },
        "overrides": []
