      "id": 1,
      "title": "Fleet",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]},
          "mappings": [],
          "unit": "none"
        }
      },
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 1},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"},
      "title": "Guests up",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
          "expr": "count(up{job=\"fleet-node\"} == 1) or vector(0)",
          "legendFormat": "up",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
          "expr": "count(up{job=\"fleet-node\"}) or vector(0)",
          "legendFormat": "total",
          "refId": "B",
          "hide": true
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]},
          "unit": "none"
        }
      },
      "gridPos": {"h": 3, "w": 4, "x": 4, "y": 1},
