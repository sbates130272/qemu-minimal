          "legendFormat": "instances",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "Bps"
        }
      },
      "gridPos": {"h": 3, "w": 8, "x": 8, "y": 1},
