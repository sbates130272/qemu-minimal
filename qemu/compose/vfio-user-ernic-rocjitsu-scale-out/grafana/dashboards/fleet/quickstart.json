        {
          "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
          "expr": "sum(rate(ernic_rdma_bytes_total[$__rate_interval]))",
          "legendFormat": "RDMA",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": {"type": "prometheus", "uid": "fleet-prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]},
