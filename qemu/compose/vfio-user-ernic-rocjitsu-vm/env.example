# Docker image references.
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:latest
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:latest
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:latest

# Number of vfio-user GPU server replicas to start.
ERNIC_COUNT=1
ROCJITSU_COUNT=1

# rocjitsu GPU config — filename relative to /usr/local/share/rocjitsu/configs/
# inside the rocjitsu image. Available configs include:
#   gfx1250_mi455x.json  gfx950_mi355x.json  gfx942_cdna3.json  gfx1100_w7900.json
ROCJITSU_CONFIG=gfx1250_mi455x.json

# Path to the qemu-minimal repo root (used to install qemu-tool into the qemu container).
# Defaults to four directories up from the compose file, which is the repo root when
# running from qemu/compose/vfio-user-vm/.
QEMU_TOOL_SRC=../../..

# Directory containing qcow2 VM images (backing files must also live here).
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# VM name — basename of the qcow2 without extension.
VM_NAME=qemu-minimal

# VM resources.
VM_VCPUS=4
VM_VMEM=8192

# SSH port forwarded from the qemu container to the host.
VM_SSH_PORT=2222

# Shared memory for the vfio-user memfd backend (must be >= VM_VMEM MiB).
VM_SHM_SIZE=8g
