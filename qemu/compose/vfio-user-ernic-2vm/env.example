# Docker image references.
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:latest
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:latest
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:latest

# rocjitsu GPU config — filename relative to /usr/local/share/rocjitsu/configs/
ROCJITSU_CONFIG=gfx1250_mi455x.json

# TCP port the ernic manager listens on (workers connect to this).
ERNIC_TCP_PORT=6320

# MAC addresses for each ernic NIC — must be unique across the mesh.
ERNIC1_MAC=72:6f:63:6d:00:01
ERNIC2_MAC=72:6f:63:6d:00:02

# Directory containing qcow2 VM images. Both VM images must live here.
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# VM names — each VM needs its own qcow2 overlay (distinct filenames).
# Both can share the same backing file; use qemu-tool gen-vm --restore-image
# to create a second overlay from an existing backing.
VM1_NAME=qemu-minimal
VM2_NAME=qemu-minimal-2

# VM resources (shared by both VMs).
VM_VCPUS=4
VM_VMEM=8192

# SSH ports forwarded from each qemu container to the host.
VM1_SSH_PORT=2222
VM2_SSH_PORT=2223

# Shared memory for the vfio-user memfd backend (must be >= VM_VMEM MiB).
VM_SHM_SIZE=8g

# Path to the qemu-minimal repo root (used to install qemu-tool into the qemu
# containers). Defaults to three directories up from the compose file.
QEMU_TOOL_SRC=../../..
