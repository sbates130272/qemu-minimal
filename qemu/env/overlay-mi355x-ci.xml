<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI overlay for the MI355X topology stack (1 VM on a 4-core runner).

  Layers on top of mi355x-node.xml. Only keys that differ from the golden
  file are present here; all other settings are inherited from mi355x-node.xml.

  Runs ONE VM where the lab stack is four: a runner has 4 cores against the
  stack's 32, so vcpus and vmem are halved, and shm_size returns to default.

  Usage: qemu-tool gen-compose
    fleet-file: qemu/env/mi355x-node.xml, qemu/env/overlay-mi355x-ci.xml
    output-dir: /var/lib/qemu-tool/stacks/mi355x-ci
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">

  <vm-count>1</vm-count>
  <vm-name-prefix>mi355x-ci</vm-name-prefix>
  <vm-vcpus>4</vm-vcpus>
  <vm-vmem>6144</vm-vmem>
  <!-- Returns to FleetConfig default (8g), overriding mi355x-node's 16g. -->
  <vm-shm-size>8g</vm-shm-size>
  <vm-images-dir>/var/lib/qemu-tool/images</vm-images-dir>
  <prom-data-dir>/var/lib/qemu-tool/stacks/mi355x-ci/prom-data</prom-data-dir>

</fleet>
