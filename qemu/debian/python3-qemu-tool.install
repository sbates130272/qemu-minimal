packages.d/packages-default usr/share/qemu-tool/
packages.d/packages-minimal usr/share/qemu-tool/
# The fleet files, one per stack. rocm-golden.xml is also the template an
# admin copies to /etc/qemu-tool/fleet.xml; nothing seeds that file.
stacks/rocm-golden.xml usr/share/qemu-tool/stacks/
stacks/helios-tray.xml usr/share/qemu-tool/stacks/
stacks/mi355x-server.xml usr/share/qemu-tool/stacks/
stacks/xio.xml usr/share/qemu-tool/stacks/
# Fleet overlays, which layer onto a stack's file. `quick-start --vfu-doorbell`
# reads vfu-doorbell.xml from here.
overlays/vfu-doorbell.xml usr/share/qemu-tool/overlays/
# The schemas for those files, RELAX NG and XSD, generated by
# `qemu-tool fleet-schema`.
schema/fleet.rng usr/share/qemu-tool/schema/
schema/fleet.xsd usr/share/qemu-tool/schema/
# Every stack compose.py's _STACKS advertises, and every file it needs to
# come up -- the same set the wheel carries. A stack directory is used
# verbatim as a `docker compose` working directory, and Docker creates a
# missing bind-mount source as an empty directory rather than erroring.
compose/rocm-golden/docker-compose.yml usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/prometheus.yml usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/fleet-inventory.yml usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/README.md usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/grafana usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/logging usr/share/qemu-tool/compose/rocm-golden/
compose/rocm-golden/tapsetup usr/share/qemu-tool/compose/rocm-golden/
compose/helios-tray/docker-compose.yml usr/share/qemu-tool/compose/helios-tray/
compose/helios-tray/prometheus.yml usr/share/qemu-tool/compose/helios-tray/
compose/helios-tray/fleet-inventory.yml usr/share/qemu-tool/compose/helios-tray/
compose/helios-tray/grafana usr/share/qemu-tool/compose/helios-tray/
compose/helios-tray/logging usr/share/qemu-tool/compose/helios-tray/
compose/helios-tray/tapsetup usr/share/qemu-tool/compose/helios-tray/
compose/mi355x-server/docker-compose.yml usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/prometheus.yml usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/fleet-inventory.yml usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/README.md usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/grafana usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/logging usr/share/qemu-tool/compose/mi355x-server/
compose/mi355x-server/tapsetup usr/share/qemu-tool/compose/mi355x-server/
compose/xio/docker-compose.yml usr/share/qemu-tool/compose/xio/
compose/xio/prometheus.yml usr/share/qemu-tool/compose/xio/
compose/xio/fleet-inventory.yml usr/share/qemu-tool/compose/xio/
compose/xio/grafana usr/share/qemu-tool/compose/xio/
