#!/usr/bin/make -f
%:
	dh $@ --with python3 --buildsystem=pybuild

STAGED_PKG = debian/python3-qemu-tool/usr/lib/python3/dist-packages/qemu_tool

# The wheel bundles the compose stacks, the manifests, env.example and the man
# page so `pipx install qemu-tool` has them -- a rootless install has no
# /usr/share/qemu-tool to read. This package ships all of it at the FHS
# locations instead, and those come first in the runtime lookup, so the
# bundled copy would just be a second copy of every file in one package.
#
# This has to run at dh_installdeb, not dh_auto_install: dh_python3 re-stages
# the package between the two, so an earlier removal is silently undone.
execute_before_dh_installdeb:
	rm -rf $(STAGED_PKG)/share $(STAGED_PKG)/man
