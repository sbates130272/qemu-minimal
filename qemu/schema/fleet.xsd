  <xs:group name="child.backend">
    <xs:sequence>
      <xs:element name="backend">
        <xs:annotation>
          <xs:documentation>Sets an ernic NIC's RDMA backend; any type but tcp takes that NIC out of the generated TCP mesh. ernic only. Text is the backend's own options, optional, as one word with no whitespace: size=1G,ns=2,kv=1,size=256M. The parser checks only that; tcp takes none.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="f:backend.options">
              <xs:attribute name="type" use="required">
                <xs:annotation>
                  <xs:documentation>Which RDMA backend the NIC's server runs. none, loopback, tcp, nvmeof or s3. Required on &lt;backend&gt;, and its only attribute.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="loopback"/>
                    <xs:enumeration value="tcp"/>
                    <xs:enumeration value="nvmeof"/>
                    <xs:enumeration value="s3"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:attribute>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.log-level">
    <xs:sequence>
      <xs:element name="log-level">
        <xs:annotation>
          <xs:documentation>Log verbosity of this NIC's server. none, error, warn, info or debug; the server's default is warn. The parser does not check the word.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.nic-profile">
    <xs:sequence>
      <xs:element name="nic-profile">
        <xs:annotation>
          <xs:documentation>Shapes the NIC from a profile; repeatable, and later profiles win. A built-in name (compat, small-vm, generic-100g, generic-400g) or a path to an ini file inside the server container. Repeatable, order kept; a later layer naming it replaces all earlier values.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.stats-interval-ms">
    <xs:sequence>
      <xs:element name="stats-interval-ms">
        <xs:annotation>
          <xs:documentation>How often the server rewrites the guest's statistics; overrides every profile. Milliseconds, 10 to 60000; the server's default is the profile's, 1000. The parser does not check the number or range.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.eth-queues">
    <xs:sequence>
      <xs:element name="eth-queues">
        <xs:annotation>
          <xs:documentation>Number of Ethernet Rx/Tx queues the NIC offers the guest; overrides every profile. Integer 1 to 64; the server's default is the profile's, 4. The guest uses at most one per vCPU. The parser does not check the number or range.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.inject">
    <xs:sequence>
      <xs:element name="inject">
        <xs:annotation>
          <xs:documentation>Injects a fault into this NIC's server, for testing; repeatable. One fault as 'SITE: PATTERN effect EFFECT', for example 'stats_vals: every 100 effect fail status eio'. Spaces allowed. Repeatable, order kept; unchecked by the parser.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.config">
    <xs:sequence>
      <xs:element name="config">
        <xs:annotation>
          <xs:documentation>Names the rocjitsu simulation config file for this one GPU, in place of &lt;rocjitsu-config&gt;. rocjitsu only. One file name in the image's configs directory, no path: starts with a letter or digit, then letters, digits, '.', '_', '-'. Example gfx1250_mi455x.json.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([A-Za-z0-9][A-Za-z0-9._\-]*)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.node">
    <xs:sequence>
      <xs:element name="node">
        <xs:annotation>
          <xs:documentation>Selects one local node from a rocjitsu system manifest; needed for a multi-node launch. A node name from the manifest the config file refers to; unchecked by the parser.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.cpu-thread-budget">
    <xs:sequence>
      <xs:element name="cpu-thread-budget">
        <xs:annotation>
          <xs:documentation>Overrides the CPU thread budget of this GPU's server; zero selects automatic sizing. Integer count of threads; 0 is automatic. The parser does not check that it is a number.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.wait-checking">
    <xs:sequence>
      <xs:element name="wait-checking">
        <xs:annotation>
          <xs:documentation>Overrides this GPU server's wait checks. off disables checks, on enables ordinary checks, all adds the gfx1250 XCNT checks. The parser does not check the word.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;]([^\t\n\r&#x7F;&#x85;&#x2028;&#x2029;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;&#x7F;])?)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.verbose">
    <xs:sequence>
      <xs:element name="verbose">
        <xs:annotation>
          <xs:documentation>Raises the SDXI server's log verbosity; repeat it for debug output. A switch: empty element, no value, no attributes. May be repeated; each occurrence renders one --verbose.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.namespaces">
    <xs:sequence>
      <xs:element name="namespaces">
        <xs:annotation>
          <xs:documentation>The namespaces the SPDK NVMe controller serves, in order; sets the image's NVME_NAMESPACES. One word, comma list, NSIDs in list order: lba:malloc:SIZE[:BLOCK], lba:aio:PATH[:BLOCK[:SIZE]], kv:mem[:MAXVAL[:MAXKEYS]]. Image default lba:malloc:512M,kv:mem.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([A-Za-z0-9_.:,/=\-]+)[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.serial">
    <xs:sequence>
      <xs:element name="serial">
        <xs:annotation>
          <xs:documentation>Serial number of the SPDK NVMe controller, as the guest sees it; sets the image's SPDK_SERIAL. 1 to 20 letters, digits, '_' and '-'. Image default SPDKVFU01.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*([A-Za-z0-9_\-]{1,20})[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:group name="child.cpumask">
    <xs:sequence>
      <xs:element name="cpumask">
        <xs:annotation>
          <xs:documentation>Host cores the SPDK server's poll-mode reactor spins on; sets SPDK_CPUMASK. Each server takes one full core. Hexadecimal core mask, 0x then 1 to 32 hex digits, such as 0x4. Default 0x1, host CPU 0. One value for every guest's server, so guests share the cores it names.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*(0x[0-9A-Fa-f]{1,32})[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:simpleType name="backend.options">
    <xs:restriction base="xs:string">
      <xs:pattern value="[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*[^\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*[\t\n\r &#x85;&#xA0;&#x1680;&#x2000;-&#x200A;&#x2028;&#x2029;&#x202F;&#x205F;&#x3000;]*"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
