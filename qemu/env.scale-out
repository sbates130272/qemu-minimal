# qemu-tool settings for the scale-out ernic+rocjitsu fleet.
#
# An N-VM rocm-ernic mesh, one emulated RDMA NIC and one rocjitsu GPU per VM.
# Not copied to qemu/.env -- named explicitly, the way the rocjitsu lane does it
# (see ansible/playbooks/roles/rocjitsu_gpu_test/defaults/main.yml):
#
#   qemu-tool gen-compose --env-file qemu/env.scale-out
#   qemu-tool compose --env-file qemu/env.scale-out \
#     --stack vfio-user-ernic-rocjitsu-scale-out --profile metrics up -d
#
# Everything in qemu/env.example applies here too -- same syntax, same
# precedence, same consumers. This file adds the fleet keys and the list
# semantics below. Read env.example first; it explains the keys that are
# merely repeated here.
#
# ---- List semantics -------------------------------------------------------
#
# Per-VM values are comma-lists, not numbered keys: VM1_NAME/VM2_NAME does not
# survive 8 VMs, let alone the mesh's 64. For any key naming a scalar VMConfig
# field:
#
#   a bare value broadcasts to every VM        VM_VCPUS=4
#   a comma-list applies positionally          VM_VMEM=8192,8192,...,16384
#   any length other than VM_COUNT is an error, naming the key and both lengths
#
# The exception, and it matters: three VMConfig fields are ALREADY list[str] --
# pci_hostdev, vfio_userdev, extra_hostfwd (config.py:73,76,84) -- where the
# commas mean "several values for ONE VM". VM_EXTRA_HOSTFWD=a,b is two hostfwd
# rules for every guest, NOT one rule each for two guests. The generator tells
# the two cases apart from VMConfig's own type hints rather than a hand-kept
# list of names, so a scalar field added later becomes per-VM-overridable for
# free. Do not "fix" a list[str] key by padding it to VM_COUNT.
#
# The comma-list form is understood by the generator ONLY. run-vm and gen-vm
# coerce VM_VMEM and friends with int(), so pointing them straight at a file
# using it exits with "Error: VM_VMEM must be an integer, got '8192,...'".
# That is the intended split and not a bug to work around: the fleet's run-vm
# invocations get their values as CLI flags the generator has already resolved
# per VM, and never read this file. Keep the lists commented out while you are
# also using this file for one-off gen-vm/run-vm runs.

# ---------------------------------------------------------------------------
# Fleet shape
# ---------------------------------------------------------------------------

# Authoritative. Names no VMConfig field, so run-vm ignores it
# (envfile.overrides() iterates dataclass fields, envfile.py:98-99).
#
# Ceilings, nearest first -- and none of them is memory:
#
#   ~40 registered mesh nodes. Past that, workers die on "TCP: Registration
#   timeout" in a permanent restart loop and their guests die with them. The
#   mesh is a full mesh, so registering node N+1 costs N new connections
#   against a fixed timeout, through a single-threaded manager. Asking for 64
#   VMs settles at 40 of 64, on an idle host as much as a busy one. This is
#   the wall that actually binds; see AGENTS.md issue 17.
#
#   VM_VCPUS x VM_COUNT <= nproc, plus ~25%. The mesh manager's heartbeat
#   timeout is 20 s of wall clock and is not tunable, so an oversubscribed host
#   does not just run slowly -- the manager mistakes slow nodes for dead ones,
#   evicts them, and every guest attached to an evicted node dies with
#   "vfio-user: timed out waiting for reply". Measured on 128 cores at 4 vCPU:
#   40 VMs clean in 117 s, 44 lose 3, 48 lose 7, with 107G of 503G in use.
#
#   VM_SHM_SIZE x VM_COUNT <= /dev/shm -- at 8g, ~30 VMs on a 252G host.
#
#   64 mesh nodes (rdma_backend_tcp.c:2570), which is a cap on CONNECTION
#   EVENTS, not on VMs: a reconnect takes a new node id and never reclaims the
#   old one. See AGENTS.md issue 13. Listed last because it is not reachable:
#   the 64-VM fleet peaked at node id 30 before registration stopped working.
#
# None of them binds at 8.
VM_COUNT=8

# Identity. Leave VM_NAMES empty to derive <VM_NAME_PREFIX>-<n> for n in
# 1..VM_COUNT; each VM needs its own qcow2 overlay of that name, which
# gen-compose prints the gen-vm commands that create them. Set VM_NAMES to name
# them individually;
# if set, its length must equal VM_COUNT.
VM_NAME_PREFIX=stebates-fleet
#VM_NAMES=

# ---------------------------------------------------------------------------
# Images -- containers AND qcow2, one build stamp across all four
# ---------------------------------------------------------------------------

# batesste-ci-images tags are <date>.<ci-sha>-<component>, and the qcow2 is
# published to Docker Hub under the same scheme, so "is this set coherent?" is
# a string comparison. The generator asserts it: all four must share one
# <date>.<ci-sha>, and QEMU_IMAGE/ERNIC_IMAGE must share one vfu.* revision.
#
# Both checks guard the same failure. A guest driver and a host rocm-ernic
# server built from different SHAs do not fail cleanly across the vfio-user/DSR
# boundary -- they surface as the DSR -ETIMEDOUT and "Failed to register ibdev"
# symptoms in AGENTS.md, which look like a wedged device rather than a version
# problem. At 8 VMs that is an expensive afternoon.
#
# Pinned to 20260925.g12f12f8: the newest stamp at which the qcow2 and all three
# containers exist. The 2026-09-29 push rebuilt the containers but not the
# ernic-rocjitsu qcow2; pairing them would put a 7b6fa94 guest against a 1484557
# server. Move all four together when the matching qcow2 publishes.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user:20260925.g12f12f8-qemu11.1.1-vfu.8039244
ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20260925.g12f12f8-ernic.0b48aa1-vfu.8039244
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20260925.g12f12f8-rocjitsu.c85bb75

# The backing qcow2, as an OCI artifact -- artifactType
# application/vnd.batesste.vm-image.v1, one zstd layer named
# batesste-ci-vm.qcow2.zst. Not a runnable image: fetch it with `oras pull`,
# not `docker pull`. `qemu-tool gen-vm --backing-image "$VM_BACKING_IMAGE"`
# does the pull and the decompression.
# The bare (non -qcow2) tag is a conventional image carrying the same file,
# ~2 GiB larger, extractable with docker create + docker cp if oras is absent.
VM_BACKING_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qcow2-gen-ernic-rocjitsu:20260925.g12f12f8-vm.resolute-ernic-rocjitsu-qm.e73a1e6-qcow2

# ---------------------------------------------------------------------------
# Per-VM resources  (scalar broadcasts; comma-list of length VM_COUNT overrides)
# ---------------------------------------------------------------------------

# Do not drop below 4 on an ernic stack: ionic_lif_size() derives its EQ count
# from num_online_cpus() and ionic_create_rdma_admin() rejects fewer than
# IONIC_EQ_COUNT_MIN, so ionic_rdma never probes. The only symptom is
# "Failed to register ibdev" in the guest log. Applies to every VM in the
# fleet, so a per-VM list that drops one below 4 breaks only that VM -- which
# is harder to spot than breaking all of them.
VM_VCPUS=4
VM_VMEM=8192

# Shared memory for the vfio-user memfd backend. Must be >= VM_VMEM MiB, per
# VM. VM_COUNT of these have to fit in /dev/shm simultaneously.
VM_SHM_SIZE=8g

# A heterogeneous fleet looks like this -- VMs 7 and 8 get 16G, the rest 8G:
#VM_VMEM=8192,8192,8192,8192,8192,8192,16384,16384

# rocjitsu GPU config, a filename under /usr/local/share/rocjitsu/configs/
# inside the rocjitsu image. Available: gfx1250_mi455x.json gfx950_mi355x.json
# gfx942_cdna3.json gfx1100_w7900.json. Per-VM lists work here too.
ROCJITSU_CONFIG=gfx1250_mi455x.json

# ---------------------------------------------------------------------------
# Fleet-wide -- never per-VM
# ---------------------------------------------------------------------------

# Not /var/lib/qemu-tool/images: this checkout keeps its qcow2s in-tree.
VM_IMAGES_DIR=/home/AMD/stebates/Projects/qemu-minimal/images

# Required, not optional, at VM_COUNT > 1. All VMs open one backing file, which
# needs backing.file.locking=off (run_vm.py:267-269). images/ is also NFS
# here, where qcow2 locking is unreliable regardless of sharing.
VM_BACKING_SHARED=true

# /16 the fleet's containers are addressed out of. Every service gets a fixed
# address -- <prefix>.<family>.<n>, family 0 infra / 1 ernic / 2 rocjitsu /
# 3 qemu -- and nothing resolves a service name at run time.
#
# That is a scaling fix, not tidiness. Docker runs one embedded DNS resolver
# per network, and a fleet start burst saturates it: at VM_COUNT=48 (144
# containers) workers died with "Temporary failure in name resolution", and
# because the mesh hands out a NEW node id on every reconnect and never
# reclaims the old one, the restart churn walked a 48-VM fleet to node id 61
# against a 64-node protocol ceiling. Change this only to dodge a subnet
# collision with something else on the host.
FLEET_NET_PREFIX=172.31

# TCP port the ernic mesh manager listens on; every worker connects to it.
# One port for the whole fleet -- the services are on the compose network, so
# there is no host-side collision to avoid.
ERNIC_TCP_PORT=6320

# ---------------------------------------------------------------------------
# Derived per-VM identity
# ---------------------------------------------------------------------------
#
# All four are computed from VM_COUNT and the bases below. The override lists
# exist for the awkward cases -- an image whose netplan pins a MAC, or a host
# where some port is already taken -- and should normally stay empty.
#
#   ssh port   VM_SSH_PORT_BASE + n - 1
#   RDMA MAC   <ERNIC_MAC_PREFIX>:<n >> 8>:<n & 0xff>
#   guest IP   <ERNIC_GUEST_SUBNET>.<10 + n>
#
# The ernic and rocjitsu socket paths (/run/vfu/{ernic,rocjitsu}-<n>.sock) are
# derived only, with no override: they are internal wiring between services the
# generator emits together, so an override could only desynchronise them.

VM_SSH_PORT_BASE=2222

# "rocm" in ASCII. 0x72 has the locally-administered bit set and the multicast
# bit clear, so the whole space is ours to hand out. Two derived octets, so the
# scheme is good to 65534 VMs; the mesh gives out at 64 first.
ERNIC_MAC_PREFIX=72:6f:63:6d

# Guests get .11 upward. Avoid .1: the mesh manager claims it as its DHCP
# server_ip and intercepts ARP for it, so a VM that takes .1 is unreachable in
# a way that looks like a driver fault (AGENTS.md known issue 1).
ERNIC_GUEST_SUBNET=192.168.100

#VM_SSH_PORTS=
#ERNIC_MACS=
#ERNIC_GUEST_IPS=

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

# An existing run-vm key (config.py:84), not a fleet-specific one. The guests
# are behind QEMU SLIRP inside their qemu containers and have no Docker network
# address of their own -- Prometheus scrapes the CONTAINER, qemu-<n>:9100, and
# this rule forwards that to the guest. Each container has its own netns, so
# one rule serves the whole fleet with no per-VM port arithmetic and nothing
# published to the host.
#
# prometheus-node-exporter is already in the image: vm-basic.yml runs
# fave_packages, whose fave_packages_node_exporter_enable defaults true.
#
# This is a list[str] field -- see the note at the top. Adding a second rule
# here gives BOTH rules to EVERY VM.
VM_EXTRA_HOSTFWD=tcp::9100-:9100

# The other scrape source, and the interesting one: each rocm-ernic writes a
# stats dump every ~1s under -S (pvrdma_stats.c:85-186) -- per-QP bytes,
# doorbells, CQEs, WQEs by opcode, MMIO and interrupt counts. A sidecar parses
# those into Prometheus text on this port. Costs the guests nothing, which is
# why the in-guest GPU exporters are deliberately NOT scraped here:
# amd-metrics-exporter (:5000) and hsa-snoop-prometheus (:9488) poll the
# emulated device, and rocjitsu serves single-threaded, so every scrape is
# taken out of the same thread as whatever workload is running
# (rocjitsu_gpu_test/defaults/main.yml:14-24).
#
# 9840 is rocm-ernic's own exporter port (prometheus/ernic-exporter). Matching
# it is what lets grafana/ernic-dashboard.json work here unmodified.
ERNIC_STATS_PORT=9840

# File-descriptor limit for every ernic service. Docker's default soft limit
# is 1024, and the mesh manager leaks an fd for every node it evicts -- the
# evicted worker reconnects on a new socket and the old one is never closed.
# At fleet scale that reaches 1024 inside a normal run, after which the
# manager spins in an accept()/EMFILE loop and its guest dies. Raising this
# does not fix the leak, it buys the run enough headroom to finish.
# Give the guest working Ethernet by attaching each ernic to a TAP that a
# short-lived privileged sidecar bridges onto a shared L2 network. The TCP
# mesh carries RDMA payload only, so without this ARP goes unanswered and
# inter-node ib_send_bw cannot do its out-of-band exchange at all. Costs one
# extra container per VM at start, which exits immediately.
ERNIC_TAP=true

ERNIC_NOFILE=65536

# Where Prometheus keeps its TSDB, bind-mounted into the container. Relative
# paths resolve against the stack directory. This is a bind mount rather than
# a named volume on purpose: the TSDB is the record of a fleet run, and a
# named volume buries it under /var/lib/docker/volumes as root, where it is
# invisible to whoever ran the fleet and is silently reused by the next run
# of a different size. Point this at a per-run directory to keep runs apart
# and to archive one next to its dashboards.
#
# Create it before `up` and make it writable by the container's user, which
# is nobody (65534) in prom/prometheus. Docker creates a missing bind-mount
# source as root, and Prometheus then exits on "opening storage failed:
# permission denied":
#
#   mkdir -p <dir> && sudo chown 65534:65534 <dir>
PROM_DATA_DIR=./prom-data

PROM_PORT=9090
PROM_SCRAPE_INTERVAL=15s
PROM_RETENTION=7d

# A third source, off until the two above are proven: QEMU's own QMP counters
# (balloon, blockstats, per-vcpu time), which need no guest cooperation at all.
#VM_QMP_SOCKET=

# ---------------------------------------------------------------------------
# Compose-only
# ---------------------------------------------------------------------------

# Path to the repo root, resolved relative to the compose stack directory.
QEMU_TOOL_SRC=../../..
