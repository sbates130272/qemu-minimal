From: Stephen Bates <stebates@amd.com>
Subject: [PATCH] sdxi_char: update io_uring task-work callback for kernel 7.2+

Kernel 7.2 changed io_req_tw_func_t from:
  void (*)(struct io_uring_cmd *cmd, unsigned int issue_flags)
to:
  void (*)(struct io_tw_req tw_req, io_tw_token_t tw)

Retrieve the io_uring_cmd pointer via io_uring_cmd_from_tw() and pass 0
as issue_flags to io_uring_cmd_done() since task-work callbacks run in
task context (not interrupt context) with no caller-supplied flags.

--- a/emulation/sdxi/drivers/sdxi_char/sdxi_char.c
+++ b/emulation/sdxi/drivers/sdxi_char/sdxi_char.c
@@ -645,8 +645,10 @@ struct sdxi_inflight {
 	u8                  ioc_buf[48];
 };

-static void sdxi_cmd_finish(struct io_uring_cmd *cmd, unsigned int issue_flags)
+static void sdxi_cmd_finish(struct io_tw_req tw_req, io_tw_token_t tw)
 {
+	struct io_uring_cmd *cmd = io_uring_cmd_from_tw(tw_req);
+	const unsigned int issue_flags = 0;
 	struct sdxi_inflight *inf = *(struct sdxi_inflight **)cmd->pdu;
 	struct sdxi_char_dev *sdev = g_sdev;
 	u8 *csb;
