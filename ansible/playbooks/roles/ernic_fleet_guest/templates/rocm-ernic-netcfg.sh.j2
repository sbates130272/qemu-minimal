#!/bin/bash
# Bring the emulated ernic up and address it at boot, with no per-guest state.
#
# This is the run-time half of the rocm-ernic configure play -- the half
# AGENTS.md issue 12 says does not survive a reboot: the netdev up, the
# address, and the counters symlink the stats exporter reads. Module loading
# and the stable names are handled by modules-load.d and 99-rocm-ernic.rules.
#
# The guest index comes from the NIC's own MAC rather than being passed in.
# gen-compose hands VM n the MAC <ERNIC_MAC_PREFIX>:<n>>8>:<n&0xff> and the
# address <subnet>.<10+n>, so the MAC already carries n and one image serves
# every guest in the fleet.
#
# Managed by Ansible (roles/ernic_fleet_guest) -- edit the template.
set -u

# The device is found by its PCI identity, not by the name udev was supposed
# to give it. The previous version hardcoded NIC=rocm-ernic0 and exited 1 when
# that name never appeared: when the guests' udev rules still matched the old
# 0x100a id, nothing was renamed, this unit failed at boot on all 32 guests,
# and they sat with no address for 18 hours. A missed rename must degrade --
# address the device under whatever name it has and say the rename is missing
# -- not take the network down with it.
#
# All four fields, because 1dd8:1002 is also a real Pensando DSC Ethernet
# Controller: only the 1dd8:5400 subsystem pair means "the emulation".
PCI_VENDOR={{ ernic_fleet_pci_vendor }}
PCI_DEVICE={{ ernic_fleet_pci_device }}
PCI_SUBSYSTEM_VENDOR={{ ernic_fleet_pci_subsystem_vendor }}
PCI_SUBSYSTEM_DEVICE={{ ernic_fleet_pci_subsystem_device }}

SUBNET={{ ernic_fleet_nic_subnet }}
PREFIX=24

# Overridable so the matcher can be exercised against a fabricated sysfs tree
# without a guest; see tests/test_ernic_identity.py.
SYSFS=${ERNIC_SYSFS_ROOT:-/sys}

attr() { cat "$1" 2>/dev/null; }

ernic_tuple() {
    printf '%s:%s:%s:%s' \
        "$(attr "$1/vendor")" "$(attr "$1/device")" \
        "$(attr "$1/subsystem_vendor")" "$(attr "$1/subsystem_device")"
}

want_tuple() {
    printf '%s:%s:%s:%s' \
        "$PCI_VENDOR" "$PCI_DEVICE" \
        "$PCI_SUBSYSTEM_VENDOR" "$PCI_SUBSYSTEM_DEVICE"
}

# EVERY matching device, not just the first: with ERNIC_PER_VM > 1 a guest has
# several emulated NICs and each is its own mesh node with its own MAC, GID and
# address. Configuring only the first left the second with a link and no
# address, which looks like a half-working fabric rather than a missing step.
#
# Renamed names come first so the ordering is stable and a guest whose udev
# rules fired keeps the name the test drivers expect at the head of the list.
# Within each group the glob sorts, so the order does not depend on readdir.
find_ernic_netdevs() {
    local dev name renamed="" fallback=""
    for dev in "$SYSFS"/class/net/*; do
        [ -e "$dev/device/vendor" ] || continue
        [ "$(ernic_tuple "$dev/device")" = "$(want_tuple)" ] || continue
        name=${dev##*/}
        case $name in
            rocm-ernic*) renamed="$renamed$name
" ;;
            *) fallback="$fallback$name
" ;;
        esac
    done
    [ -n "$renamed$fallback" ] || return 1
    printf '%s' "$renamed$fallback"
}

# What was looked for and what was actually on the bus. The fleet's symptom
# was "rocm-ernic0 never appeared", which says nothing about why.
report_no_match() {
    local dev
    echo "no netdev matches ${PCI_VENDOR}:${PCI_DEVICE} subsystem" \
         "${PCI_SUBSYSTEM_VENDOR}:${PCI_SUBSYSTEM_DEVICE}" >&2
    for dev in "$SYSFS"/class/net/*; do
        [ -e "$dev/device/vendor" ] || continue
        echo "  ${dev##*/}: $(ernic_tuple "$dev/device")" >&2
    done
}

if [ "${1:-}" = "discover" ]; then
    find_ernic_netdevs || { report_no_match; exit 1; }
    exit 0
fi

for _ in $(seq 1 30); do
    NICS=$(find_ernic_netdevs) && break
    sleep 1
done
[ -n "${NICS:-}" ] || { report_no_match; exit 1; }

# The hostname comes from the FIRST NIC only -- it names the guest, not the
# device, and a guest with two NICs would otherwise be renamed twice and keep
# whichever ran last.
first=1
rc=0

while read -r NIC; do
    [ -n "$NIC" ] || continue

    case $NIC in
        rocm-ernic*) ;;
        *) echo "warning: $NIC was not renamed by 99-rocm-ernic.rules;" \
                "check that the rules match all four of $(want_tuple)" >&2 ;;
    esac

    mac=$(cat "$SYSFS/class/net/$NIC/address")
    # Each NIC carries its own index: gen-compose numbers ernics FLAT across
    # the fleet, so guest n's two devices are 2n-1 and 2n and their addresses
    # follow from their own MACs. Deriving one index per guest would give both
    # NICs the same address.
    n=$(( 0x${mac:12:2} * 256 + 0x${mac:15:2} ))
    if [ "$n" -le 0 ]; then
        echo "refusing index 0 from MAC $mac on $NIC" >&2
        rc=1
        continue
    fi

    ip link set "$NIC" up
    addr="$SUBNET.$(( 10 + n ))"
    ip addr show dev "$NIC" | grep -q "$addr/" || ip addr add "$addr/$PREFIX" dev "$NIC"

    # The RDMA exporter reads ports/*/counters; the emulated device only
    # exposes hw_counters. Walked through the NIC's own PCI device rather than
    # globbed as rocm-rdma-ernic*, so it works on a guest whose IB rename did
    # not fire -- the published qcow2 is one such guest (AGENTS.md, udev
    # section).
    for d in "$SYSFS/class/net/$NIC/device/infiniband"/*/ports/*/; do
        [ -d "$d/hw_counters" ] || continue
        [ -e "$d/counters" ] && continue
        ln -s hw_counters "$d/counters"
    done

    if [ "$first" = 1 ]; then
        hostnamectl set-hostname "ernic-vm-$n" 2>/dev/null || true
        first=0
    fi
    echo "configured $NIC as $addr (index $n)"
done <<EOF
$NICS
EOF

exit $rc
