#!/bin/sh
# initramfs-tools hook: keep ionic, ionic_rdma and ernic_p4 out of the image.
#
# Not because they must not autoload, which is why amdgpu is excluded, but
# because the copy an initramfs carries is the wrong one. The DKMS build
# replaces the in-tree pair on the rootfs, and an initramfs generated before
# that -- or by MODULES=most sweeping every network driver in -- holds the
# earlier module. It loads first, and ionic_rdma and ernic_p4, built against
# the patched ionic, then fail on a symbol version mismatch that names
# nothing about an initramfs.
#
# Dropping them is safe: root is on virtio and the emulated NIC is not a boot
# device.
#
# resolute's mkinitramfs calls apply_add_modules twice, once before hooks and
# once after, so deleting the files from $DESTDIR is not enough -- the second
# pass re-adds them from __MODULES_TO_ADD. Clear both.
PREREQ=""
prereqs() { echo "${PREREQ}"; }
case "${1}" in prereqs) prereqs; exit 0 ;; esac
[ -n "${DESTDIR}" ] || exit 0
if [ -n "${__MODULES_TO_ADD:-}" ] && [ -f "${__MODULES_TO_ADD}" ]; then
    grep -vxE 'ionic|ionic_rdma|ernic_p4' "${__MODULES_TO_ADD}" \
        > "${__MODULES_TO_ADD}.keep" || true
    mv "${__MODULES_TO_ADD}.keep" "${__MODULES_TO_ADD}"
fi
find "${DESTDIR}" -name 'ionic.ko*' -delete
find "${DESTDIR}" -name 'ionic_rdma.ko*' -delete
find "${DESTDIR}" -name 'ernic_p4.ko*' -delete
