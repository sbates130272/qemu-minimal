# image files for virtual machines — the whole directory is local runtime
# state: qcow2s, NVMe images, keypairs, sidecars, temp dirs. Nothing here
# belongs in version control.
images/
libvirt/*-server-cloudimg-*.img

# emacs backup files
*~

# Python related
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editor related
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.bak

# MkDocs build output
site/

# Debian package related
*.deb
*.buildinfo
*.changes
*.dsc

# pybuild / setuptools working directories under qemu/
qemu/.pybuild/
qemu/build/
qemu/dist/

# debhelper related
qemu/debian/python3-qemu-tool/
qemu/debian/.debhelper/
qemu/debian/*.debhelper
qemu/debian/*.substvars
qemu/debian/debhelper-build-stamp
qemu/debian/files

# Run output
*.log

# Cloud-init generated files
cloud-config-*
network-config-*

# Temporary files
*.tmp

# Environment files. qemu-tool reads none; these are a shell's or docker
# compose's own, and carry machine-specific values.
.env
.env.*

# A personal fleet.xml on the settings search path. The committed settings
# files beside it in qemu/stacks/ have other names, so they stay tracked.
qemu/stacks/fleet.xml

# Scratch output from local fleet runs -- rendered dashboards, captured
# metrics. Reproducible from a running stack, so it is not worth versioning.
artifacts/

# Prometheus TSDB, bind-mounted into the metrics profile (<prom-data-dir>).
# quick-start puts it inside the stack directory; it is run output, not source.
prom-data/

# Added by ggshield
.cache_ggshield

# Ansible lock files
.ansible/.lock
