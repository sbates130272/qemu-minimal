# image files for virtual machines
images/*.ISO
images/*.iso
images/*.img
images/*.qcow2
libvirt/focal-*.img
libvirt/jammy-*.img
libvirt/noble-*.img

# emacs backup files
*~

# temporary hostname files
libvirt/hostname.tmp

# Python related
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Editor related
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.bak

# Build artifacts
*.o
*.a
*.so
*.ko.cmd
.tmp_versions/
Module.symvers
modules.order

# Debian package related
*.deb
*.buildinfo
*.changes
*.dsc

# pybuild / setuptools working directories under qemu/
qemu/.pybuild/
qemu/build/
qemu/dist/
qemu/qemu_tool.egg-info/

# debhelper related
qemu/debian/python3-qemu-tool/
qemu/debian/.debhelper/
qemu/debian/*.debhelper
qemu/debian/*.substvars
qemu/debian/debhelper-build-stamp
qemu/debian/files

# QEMU runtime
*.pid
*.log

# Cloud-init generated files
cloud-config-*
network-config-*
*-seed.qcow2

# Temporary files
*.tmp

# Environment files. .env.* covers per-profile settings files such as
# .env.rocjitsu, selected with --env-file or $QEMU_TOOL_ENV. env.example has no
# leading dot, so it stays tracked.
.env
.env.*
