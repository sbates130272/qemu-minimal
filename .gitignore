# personal runbooks — not for version control
vm-ernic-rocjitsu.md

# image files for virtual machines
images/*.ISO
images/*.iso
images/*.img
images/*.qcow2
# gen-vm's per-VM sidecar, next to the qcow2 it describes. Local state, not
# an artefact: it records the guest account and an absolute path to a key on
# this machine, and inspect regenerates nothing from it that gen-vm cannot.
images/*.json
libvirt/focal-*.img
libvirt/jammy-*.img
libvirt/noble-*.img

# emacs backup files
*~

# temporary hostname files
libvirt/hostname.tmp

# Python related
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Editor related
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.bak

# Build artifacts
*.o
*.a
*.so
*.ko.cmd
.tmp_versions/
Module.symvers
modules.order

# Debian package related
*.deb
*.buildinfo
*.changes
*.dsc

# pybuild / setuptools working directories under qemu/
qemu/.pybuild/
qemu/build/
qemu/dist/
qemu/qemu_tool.egg-info/

# debhelper related
qemu/debian/python3-qemu-tool/
qemu/debian/.debhelper/
qemu/debian/*.debhelper
qemu/debian/*.substvars
qemu/debian/debhelper-build-stamp
qemu/debian/files

# QEMU runtime
*.pid
*.log

# Cloud-init generated files
cloud-config-*
network-config-*
*-seed.qcow2

# Temporary files
*.tmp

# Environment files. .env.* covers per-profile settings files such as
# .env.rocjitsu, selected with --env-file or $QEMU_TOOL_ENV. The committed
# settings files live in qemu/env/ with no leading dot, so they stay tracked.
.env
.env.*

# Scratch output from local fleet runs -- rendered dashboards, captured
# metrics. Reproducible from a running stack, so it is not worth versioning.
artifacts/

# Prometheus TSDB, bind-mounted into the metrics profile (PROM_DATA_DIR).
# Default lands inside the stack directory; it is run output, not source.
prom-data/

# Ad-hoc env overlays for one machine. qemu/env/scale-out is the committed,
# authoritative one and qemu/env/overlay-* are the committed deltas layered on
# it with a second --env-file; these carry machine-specific absolute paths
# (VM_IMAGES_DIR, VM_FILESYSTEM) and locally built image tags, so they are
# useful to keep and wrong to share.
qemu/env/local-*

# Added by ggshield
.cache_ggshield
